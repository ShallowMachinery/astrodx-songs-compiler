# ==============================================================================
# AstroDX Songs Compiler - Git Ignore
# ==============================================================================

# User configuration (contains machine-specific local paths)
# Use config.example.json as template
config.json
*.local
*.env
.env.*

# SEGA API Scraper Cache (dynamically fetched at runtime)
sega_songs_cache.json

# Compiled AstroDX archives and temporary packages
*.adx
*.tmp_adx
output/
dist/
build/

# External cloned reference repository
arcade-songs-fetch/

# Temporary / Scratch scripts used during development
check_local_plus.py
inspect_plus.py
test_fetch.py
test_intl.py
match_songs.py
scratch/

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/

# IDE & Editor settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Logs & temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
